# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
VITE_GEMINI_API_KEY=""

# OPENWEATHER_API_KEY: For live weather and rainfall data.
OPENWEATHER_API_KEY=""
VITE_OPENWEATHER_API_KEY=""

# BHASHINI_API_KEY: For Indian language translation and TTS voice synthesis.
BHASHINI_API_KEY=""

# WHISPER_API_KEY: For Whisper speech-to-text fallback / backend API.
WHISPER_API_KEY=""

# AGMARKNET_API_KEY: For live Agmarknet / Government mandi market prices.
AGMARKNET_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

